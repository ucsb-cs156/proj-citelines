{
  "databaseChangeLog": [
    {
      "changeSet": {
        "id": "040-add-citation-format-to-projects",
        "author": "pc",
        "preConditions": [
          { "onFail": "MARK_RAN" },
          {
            "and": [
              { "tableExists": { "tableName": "project" } },
              { "not": { "columnExists": { "tableName": "project", "columnName": "citation_format" } } }
            ]
          }
        ],
        "changes": [
          {
            "addColumn": {
              "tableName": "project",
              "columns": [
                {
                  "column": {
                    "name": "citation_format",
                    "type": "VARCHAR(50)",
                    "defaultValue": "ACM",
                    "constraints": { "nullable": false }
                  }
                }
              ]
            }
          },
          {
            "sql": {
              "sql": "ALTER TABLE project ADD CONSTRAINT citation_format_valid CHECK (citation_format IN ('APA', 'MLA', 'ACM', 'IEEE', 'CHICAGO-AUTHOR-DATE', 'CHICAGO-FULLNOTE', 'HARVARD', 'VANCOUVER', 'NATURE', 'SCIENCE'))"
            }
          }
        ]
      }
    }
  ]
}
